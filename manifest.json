{
  "manifest_version": 3,
  "name": "agBookmarkManager",
  "version": "1.0",
  "description": "Modern, fast, and uncluttered Chrome Bookmark Manager.",
  "permissions": ["bookmarks", "storage", "unlimitedStorage", "offscreen"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bookmarks"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
